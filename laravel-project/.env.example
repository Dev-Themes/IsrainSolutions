# ==========================================
# TradeConnect Environment Configuration
# ==========================================

# 1. Neon PostgreSQL Database Connection (Free Tier from https://neon.tech)
# Pooled connection string (recommended for Vercel serverless):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection (optional, for running migrations if pooler doesn't support them):
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth Authentication Secret
# Generate with: openssl rand -base64 32 (or any long random string)
NEXTAUTH_SECRET="tradeconnect-super-secure-random-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# 3. Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://business-platform-ashy.vercel.app"

# 4. Live Cloud Email Dispatch (Gmail SMTP, Resend, or SendGrid)
# For Gmail: Use an App Password from Google Account > Security > App Passwords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-organization@gmail.com"
# SMTP_PASS="your-16-char-gmail-app-password"
# SMTP_FROM="noreply@tradeconnect.com"
