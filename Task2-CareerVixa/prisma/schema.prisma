datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum UserRole {
  ADMIN
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role               UserRole            @default(CLIENT)
  accounts           Account[]
  sessions           Session[]
  articles           Article[]
  contributorProfile ContributorProfile?
  editorialReviews   EditorialReview[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

model ContributorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  organization String?
  country      String
  phoneNumber  String?
  bio          String?  @db.Text
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?       @db.Text
  content     String        @db.Text
  coverImage  String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  tags        Tag[]         @relation("ArticleTags")

  metaTitle       String?
  metaDescription String?

  isAIGenerated      Boolean          @default(false)
  aiSourceReferences String?          @db.Text
  aiExecutionLogs    AIExecutionLog[]

  // Guest Contributor & Submission Metadata:
  guestAuthorName   String?
  guestAuthorBio    String?   @db.Text
  guestAuthorUrl    String?   @db.Text
  originalSourceUrl String?   @db.Text
  promotionalUrl    String?   @db.Text
  contentOrigin     String    @default("MANUAL") // "MANUAL" or "AI"
  submittedAt       DateTime?
  rightsDeclared    Boolean   @default(false)
  termsAcceptedAt   DateTime?
  reviewNotes       String?   @db.Text
  editorialReviews  EditorialReview[]
  // Featured Homepage Selection
  isFeatured        Boolean                  @default(false)

  // Performance & Analytics (Spec 008)
  viewsCount        Int                      @default(0)
  clicksCount       Int                      @default(0)
  analyticsEvents   ArticleAnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIConfiguration {
  id               String  @id @default(cuid())
  enabled          Boolean @default(false)
  scheduleTime     String  @default("09:00") // 24-hour format HH:MM
  timezone         String  @default("Asia/Karachi")
  topicPreferences String? @db.Text

  updatedAt DateTime @updatedAt
}

enum AIExecutionStatus {
  SUCCESS
  FAILURE
  RETRYING
}

model AIExecutionLog {
  id             String            @id @default(cuid())
  timestamp      DateTime          @default(now())
  status         AIExecutionStatus
  validationData String?           @db.Text // JSON stored as text for validation outcomes
  errorLogs      String?           @db.Text
  articleId      String?
  article        Article?          @relation(fields: [articleId], references: [id])
}

model AIPublishingLock {
  dayKey    String   @id // e.g. "2026-10-15-Asia/Karachi"
  status    String   // "LOCKED" | "COMPLETED" | "FAILED"
  articleId String?
  attempts  Int      @default(1)
  errorLogs String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  articles    Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EditorialReview {
  id          String        @id @default(cuid())
  articleId   String
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User          @relation(fields: [adminId], references: [id])
  status      ArticleStatus
  reviewNotes String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([articleId])
}

model ArticleAnalyticsEvent {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  eventType String   // "VIEW" or "PROMO_CLICK"
  referrer  String?  @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([articleId, eventType])
  @@index([createdAt])
}


