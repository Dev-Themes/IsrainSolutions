{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "agent",
          "format": "url",
          "env": "AGENT_URL"
        }
      ]
    },
    "agent": {
      "root": "agent",
      "runtime": "python",
      "entrypoint": "api.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
